# Telegram
BOT_TOKEN=your_telegram_bot_token

# Encryption password for wallet private keys
PASSWORD=your_strong_encryption_password

# Solana RPC (e.g. from Helius, QuickNode, etc.)
RPC_URL=mainnet.helius-rpc.com/?api-key=your_key

# MongoDB (default works with docker-compose)
MONGO_URI=mongodb://localhost:27017/soursop

# Redis (default works with docker-compose)
REDIS_URL=redis://localhost:6379

# Kafka (default works with docker-compose)
KAFKA_BROKERS=localhost:9092

# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
